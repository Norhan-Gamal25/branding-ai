# Copy this file to .env and fill in the values

# ── Groq (primary LLM provider) ──────────────────────────────────────────────
# Primary runtime provider. The fallback ladder tries these models first
# (llama-3.3-70b-versatile, gpt-oss-120b, qwen3.6-27b, llama-3.1-8b-instant).
GROQ_API_KEY=your-groq-api-key-here

# ── OpenAI (final fallback LLM provider) ─────────────────────────────────────
# Used only when every Groq model is exhausted or rate-limited.
# Reliable: no daily token cap. Without it, generation fails when Groq is out.
OPENAI_API_KEY=your-openai-api-key-here

# ── OpenRouter (optional free fallback) ──────────────────────────────────────
# Adds a strong free-tier model (qwen3-coder-480b) after the Groq models.
# Leave empty to skip this provider entirely.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── Hugging Face (optional free fallback) ────────────────────────────────────
# Adds a free serverless model (Llama-3.3-70B-Instruct) to the ladder.
# Leave empty to skip this provider entirely.
HF_API_KEY=your-huggingface-token-here
